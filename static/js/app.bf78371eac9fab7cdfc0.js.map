module.exports = {"type":"REST","title":"清算熱力圖","en":"Liquidation Heatmap","api":{"uri":"/openApi/swap/v1/liquidation/heatmap","method":"GET","requiresAuth":true,"rate-limitation":"1/s","ip-rate-limitation":"","payload":{"symbol":"BTC-USDT","interval":"1d"},"responseBody":{"code":0,"msg":"","data":{"symbol":"BTC-USDT","interval":"1d","source":"CoinGlass","updateTime":1794960000000,"refreshSeconds":300,"startTime":1794873600000,"endTime":1794960000000,"klineInterval":"1h","timeAxis":[1794873600000,1794877200000],"priceAxis":["63000","64000"],"points":[[0,0,"10.5"],[1,1,"20"]],"maxIntensity":"20","intensityUnit":"modelIntensity","klines":[{"time":1794873600000,"open":"63500","high":"64000","low":"63000","close":"63800"}]}},"request":{"info":["GET 請求僅使用 query 參數，不支持 body。需 X-BX-APIKEY、當前 timestamp 和 HMAC SHA256 signature。","按 UID、接口獨立限頻；清算熱力圖每秒 1 次，其餘五個接口每秒 2 次。","僅接受表中業務參數及 timestamp、recvWindow、signature；重複參數或不支持的參數返回 109400。","interval 必填，日窗口為 1d；不支持舊 range、interval=24h 或自訂 startTime/endTime/limit。","先查詢 /openApi/swap/v1/quote/chartSymbols，確認該幣對的對應 chartSupport 為 true。"],"info_en":["Use GET query parameters only; request bodies are unsupported. X-BX-APIKEY, a current timestamp and an HMAC SHA256 signature are required.","Independent quotas per UID and endpoint: 1 request/s for the heatmap, 2 requests/s for each of the other five endpoints.","Only the listed business parameters and timestamp, recvWindow, signature are accepted; duplicate or unsupported parameters return 109400.","interval is required; use 1d for the daily window. Legacy range, interval=24h and custom startTime/endTime/limit are unsupported.","First query /openApi/swap/v1/quote/chartSymbols and check the corresponding chartSupport flag for the symbol."],"list":[{"name":"symbol","type":"string","required_zh":"是","required_en":"Yes","values":"","zh":"單個大寫交易對，例如 BTC-USDT","en":"Single uppercase pair, e.g. BTC-USDT"},{"name":"interval","type":"string","required_zh":"是","required_en":"Yes","values":"12h,1d,1w,1M,3M,1y","zh":"必填的預設查詢窗口；不是 K 線或採樣週期","en":"Required preset query window; not a candle or point sampling interval"},{"name":"timestamp","type":"int64","required_zh":"是","required_en":"Yes","values":"","zh":"當前 Unix 毫秒時間戳","en":"Current Unix timestamp in milliseconds"},{"name":"recvWindow","type":"int64","required_zh":"否","required_en":"No","values":"","zh":"請求有效窗口，單位毫秒，默認 5000","en":"Request validity window in milliseconds, default 5000"},{"name":"signature","type":"string","required_zh":"是","required_en":"Yes","values":"","zh":"對全部請求參數（不含 signature）計算的 HMAC SHA256 簽名","en":"HMAC SHA256 signature of all request parameters excluding signature"}]},"response":{"info":["以下為響應結構示例，並非即時行情或測試結果；所有小數以字串返回。","updateTime 是快照發布時間；refreshSeconds 是建議刷新間隔，不表示每次請求都會生成新數據。"],"info_en":["The example illustrates the response structure; it is not live market data or a test result. All decimals are returned as strings.","updateTime is the snapshot publication time; refreshSeconds is a suggested refresh interval, not a promise of new data on every request."],"list":[{"name":"symbol","type":"string","values":"","zh":"交易對","en":"Trading pair"},{"name":"interval","type":"string","values":"","zh":"預設查詢窗口；日窗口為 1d","en":"Preset query window; the daily window is 1d"},{"name":"source","type":"string","values":"","zh":"數據來源：CoinGlass","en":"Data source: CoinGlass"},{"name":"updateTime","type":"int64","values":"","zh":"快照發布時間，Unix 毫秒時間戳","en":"Snapshot publication time as a Unix millisecond timestamp"},{"name":"refreshSeconds","type":"int64","values":"","zh":"建議刷新間隔，單位秒","en":"Suggested refresh interval in seconds"},{"name":"startTime","type":"int64","values":"","zh":"窗口開始時間，Unix 毫秒時間戳","en":"Window start as a Unix millisecond timestamp"},{"name":"endTime","type":"int64","values":"","zh":"窗口結束時間，Unix 毫秒時間戳","en":"Window end as a Unix millisecond timestamp"},{"name":"klineInterval","type":"string","values":"","zh":"附帶 K 線的週期，不是請求窗口","en":"Interval of the included candles, distinct from the requested window"},{"name":"timeAxis","type":"int64[]","values":"","zh":"升序時間軸，Unix 毫秒時間戳","en":"Ascending time axis, Unix millisecond timestamps"},{"name":"priceAxis","type":"string[]","values":"","zh":"升序價格軸，十進位字串","en":"Ascending price axis as decimal strings"},{"name":"points","type":"array[]","values":"","zh":"稀疏點 [timeIndex, priceIndex, intensity]；前兩項為從 0 開始的索引，強度為字串","en":"Sparse tuples [timeIndex, priceIndex, intensity]; zero-based integer indices and a decimal-string intensity"},{"name":"maxIntensity","type":"string","values":"","zh":"最大模型強度","en":"Maximum model intensity"},{"name":"intensityUnit","type":"string","values":"","zh":"固定為 modelIntensity；不是實際清算金額","en":"Always modelIntensity; not an actual liquidation amount"},{"name":"klines[].time","type":"int64","values":"","zh":"K 線時間，Unix 毫秒時間戳","en":"Candle time as a Unix millisecond timestamp"},{"name":"klines[].open","type":"string","values":"","zh":"K 線價格 open","en":"Candle open price as a decimal string"},{"name":"klines[].high","type":"string","values":"","zh":"K 線價格 high","en":"Candle high price as a decimal string"},{"name":"klines[].low","type":"string","values":"","zh":"K 線價格 low","en":"Candle low price as a decimal string"},{"name":"klines[].close","type":"string","values":"","zh":"K 線價格 close","en":"Candle close price as a decimal string"}]},"error":{"info":"本接口業務錯誤 data={}。網關鑑權或限頻錯誤使用網關原有響應格式。","info_en":"Business errors from this endpoint use data={}. Gateway authentication and rate-limit errors retain their own response format.","list":[{"code":109400,"msg":"參數錯誤或該幣對不支持所查圖表 / Invalid parameters or chart unsupported for this symbol"},{"code":109500,"msg":"數據暫時不可用 / Data temporarily unavailable"},{"code":100410,"msg":"超過 UID 接口限頻（網關返回） / UID endpoint rate limit exceeded (gateway response)"}]}},"info":{"zh":[{"type":"div","info":"是否驗簽: 是"},{"type":"div","info":"API Key 權限：只讀"},{"type":"div","info":"接口描述：查詢清算熱力圖。"}],"en":[{"type":"div","info":"Signature Verification: Yes"},{"type":"div","info":"API 
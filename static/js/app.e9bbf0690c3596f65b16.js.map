module.exports = {"type":"REST","title":"管道傭金明細","en":"Channel Commission Details","api":{"uri":"/openApi/agent/v1/reward/channelCommissionList","method":"GET","requiresAuth":true,"rate-limitation":"10/second","payload":{"uid":"24391361","businessType":"perpetualFutures","assetType":1,"startTime":1791820800000,"endTime":1792425600000,"pageIndex":1,"pageSize":20},"responseBody":{"code":0,"timestamp":1792425600000,"data":{"list":[{"uid":24391361,"tradingVolume":"10000","expectedTradingFees":"10","offsetTradingFees":"2","collectedTradingFees":"8","commission":"1.6","partnerCommissionRate":"0.2"}],"total":1,"currentAgentUid":12345678}},"request":{"info":["當前代理身份由 API Key 決定，uid 僅用於篩選下級管道用戶，不能用於切換當前代理。","businessType 和 assetType 可組合篩選；不傳時分別查詢全部業務類型及資產類型。","startTime 必須大於或等於 0，endTime 必須大於或等於 startTime；時間單位均為毫秒。"],"info_en":["The authenticated API Key determines the current agent. The uid parameter only filters subordinate channel users and cannot select a different current agent.","businessType and assetType can be combined. Omit either parameter to query all business types or asset types, respectively.","startTime must be at least 0, and endTime must be greater than or equal to startTime. Both values are Unix timestamps in milliseconds."],"list":[{"name":"uid","type":"long","required_zh":"否","required_en":"No","values":"","zh":"下級管道用戶 UID；不傳時不按下級 UID 篩選","en":"Subordinate channel user UID. Omit to query without filtering by subordinate UID."},{"name":"businessType","type":"string","required_zh":"否","required_en":"No","values":"standardFutures, perpetualFutures, spot","zh":"業務類型：standardFutures 標準合約、perpetualFutures 永續合約、spot 現貨；不傳或空字串表示全部","en":"Business type: standardFutures (standard futures), perpetualFutures (perpetual futures), or spot (spot trading). Omit or use an empty string to query all."},{"name":"assetType","type":"int","required_zh":"否","required_en":"No","values":"1, 2","zh":"資產類型：1 數字幣、2 傳統金融；不傳表示全部","en":"Asset type: 1 for crypto assets or 2 for traditional finance assets. Omit to query all."},{"name":"startTime","type":"int64","required_zh":"是","required_en":"Yes","values":"","zh":"查詢開始時間，Unix 毫秒時間戳，必須大於或等於 0","en":"Query start time as a Unix timestamp in milliseconds; must be at least 0."},{"name":"endTime","type":"int64","required_zh":"是","required_en":"Yes","values":"","zh":"查詢結束時間，Unix 毫秒時間戳，必須大於或等於 startTime","en":"Query end time as a Unix timestamp in milliseconds; must be greater than or equal to startTime."},{"name":"pageIndex","type":"int","required_zh":"是","required_en":"Yes","values":"","zh":"頁碼，從 1 開始","en":"Page number, starting from 1."},{"name":"pageSize","type":"int","required_zh":"是","required_en":"Yes","values":"","zh":"每頁條數，範圍為 1–100","en":"Number of records per page, from 1 to 100."},{"name":"recvWindow","type":"int64","required_zh":"否","required_en":"No","values":"","zh":"請求有效時間窗口，單位為毫秒，默認 5000","en":"Request validity window in milliseconds. Defaults to 5000."},{"name":"timestamp","type":"int64","required_zh":"是","required_en":"Yes","values":"","zh":"請求時間戳，單位為毫秒","en":"Request timestamp in milliseconds."}]},"response":{"info":["list 為當前頁數據；無匹配或頁碼超出範圍時返回空數組。","total 為符合篩選條件的總條數，頁碼超出範圍時仍保留實際總數。金額與比例字段以字串返回。"],"info_en":["list contains records for the current page and is empty when no records match or the page is out of range.","total is the total number of matching records and remains accurate for out-of-range pages. Amounts and commission rates are returned as strings."],"list":[{"name":"list","type":"array","values":"","zh":"當前頁管道傭金明細列表，元素字段如下","en":"Channel commission records for the current page. Item fields are listed below."},{"name":"total","type":"int","values":"","zh":"符合篩選條件的總條數","en":"Total number of matching records."},{"name":"currentAgentUid","type":"long","values":"","zh":"當前 API Key 所屬代理 UID","en":"UID of the agent associated with the authenticated API Key."},{"name":"list[].uid","type":"long","values":"","zh":"下級管道用戶 UID","en":"Subordinate channel user UID."},{"name":"list[].tra